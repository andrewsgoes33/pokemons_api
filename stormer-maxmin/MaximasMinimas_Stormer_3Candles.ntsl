// =============================================================
// Setup MAXIMAS E MINIMAS - Stormer (aula "A Terceira Onda")
// Fiel aos blocos do Wealth-Lab usados por ele:
//   Buy at Limit 0% below Lowest(Low,1)
//   Sell at Limit 0% above Highest(High,2)   (Same-Bar desligado)
//   Sell after 3 bars
//
// Entrada: compra limitada na MINIMA do ultimo candle fechado
// Saida 1: venda limitada na MAXIMA dos 2 ultimos candles fechados
//          (recalculada a cada candle; nunca no candle da compra)
// Saida 2: apos 3 candles posicionado (o da compra conta como o 1o),
//          zera a mercado na abertura do candle seguinte - igual ao
//          "Sell after 3 bars" do Wealth-Lab.
//
// nCandles: candles desde a entrada (0 = candle da compra,
// -1 = fora da posicao); o [1] le o valor do candle anterior.
// Nao recompra no candle da venda (Single Position do Wealth-Lab).
// =============================================================
input
  BarrasSaida(3);
var
  nCandles : Integer;
begin
  if (IsBought) then
    begin
      if (nCandles[1] < 0) then
        nCandles := 0
      else
        nCandles := nCandles[1] + 1;

      if (nCandles >= BarrasSaida) then
        SellToCoverAtMarket
      else if (nCandles >= 1) then
        SellToCoverLimit(Highest(High, 2)[1]);
    end
  else
    begin
      if (nCandles[1] < 0) then
        BuyLimit(Low[1]);

      nCandles := -1;
    end;
end;
