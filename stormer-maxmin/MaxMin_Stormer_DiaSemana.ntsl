// =============================================================
// Setup MAX-MIN do Stormer - versao original + filtro de dia da semana
//
// Fora da posicao: compra limitada na MINIMA dos 2 ultimos candles,
//                  so no dia da semana escolhido em DiaSemana
// Comprado:        venda limitada na MAXIMA dos 2 ultimos candles,
//                  em qualquer dia (a saida nao e filtrada)
// Sem stop: a saida e sempre a maxima dos 2 ultimos candles.
//
// O [1] faz a conta usar so os 2 ultimos candles JA FECHADOS.
// DayOfWeek(Date) e o dia do candle atual, ou seja, o dia em que a
// ordem de compra fica valendo e pode executar.
// =============================================================
input
  Periodo(2);
  DiaSemana(0);   // 0 = todos | 1 = seg | 2 = ter | 3 = qua | 4 = qui | 5 = sex
var
  vEntrada, vAlvo : Float;
begin
  vEntrada := Lowest(Low, Periodo)[1];
  vAlvo    := Highest(High, Periodo)[1];

  if (IsBought) then
    begin
      SellToCoverLimit(vAlvo);
    end
  else if (DiaSemana = 0) or (DayOfWeek(Date) = DiaSemana) then
    begin
      BuyLimit(vEntrada);
    end;
end;
