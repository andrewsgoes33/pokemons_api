// =============================================================
// Setup MAX-MIN do Stormer - versao original + filtro de dias da semana
//
// Fora da posicao: compra limitada na MINIMA dos 2 ultimos candles,
//                  so nos dias marcados com 1
// Comprado:        venda limitada na MAXIMA dos 2 ultimos candles,
//                  em qualquer dia (a saida nao e filtrada)
// Sem stop: a saida e sempre a maxima dos 2 ultimos candles.
//
// Deslocamento: 1 no grafico diario, 0 no intradiario.
// No diario o Profit roda o codigo enquanto o candle do dia se
// forma, e o [1] faz a conta usar so os candles ja fechados.
// No intradiario o codigo roda no fechamento de cada candle, entao
// o [0] ja e o candle que acabou de fechar; com 1 a conta atrasa
// um candle.
// =============================================================
input
  Periodo(2);
  Deslocamento(1);   // 1 = diario | 0 = intradiario
  Segunda(1);        // 1 = compra neste dia | 0 = nao compra
  Terca(1);
  Quarta(1);
  Quinta(1);
  Sexta(1);
var
  vEntrada, vAlvo : Float;
  nDia            : Integer;
  bDiaLiberado    : Boolean;
begin
  vEntrada := Lowest(Low, Periodo)[Deslocamento];
  vAlvo    := Highest(High, Periodo)[Deslocamento];

  nDia := DayOfWeek(Date);
  bDiaLiberado := False;
  if (nDia = 1) and (Segunda = 1) then bDiaLiberado := True;
  if (nDia = 2) and (Terca = 1)   then bDiaLiberado := True;
  if (nDia = 3) and (Quarta = 1)  then bDiaLiberado := True;
  if (nDia = 4) and (Quinta = 1)  then bDiaLiberado := True;
  if (nDia = 5) and (Sexta = 1)   then bDiaLiberado := True;

  if (IsBought) then
    begin
      SellToCoverLimit(vAlvo);
    end
  else if (bDiaLiberado) then
    begin
      BuyLimit(vEntrada);
    end;
end;
