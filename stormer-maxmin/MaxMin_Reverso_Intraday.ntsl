// =============================================================
// MAX-MIN REVERSO (rompimento) para INTRADAY - somente compra
//
// Fora da posicao: compra stop no rompimento da MAXIMA dos
//                  2 ultimos candles
// Comprado:        stop na perda da MINIMA dos 2 ultimos candles
//                  (so sobe enquanto a posicao estiver aberta)
// Horarios de operacao e zeragem ficam na configuracao do Profit.
//
// No intradiario o Profit roda o codigo no fechamento de cada
// candle e as ordens valem para o candle seguinte, entao [0] e o
// candle que acabou de fechar. Por isso o stop so passa a valer no
// candle seguinte ao da compra; se o candle da compra fechar abaixo
// do nivel de stop que valia nele, a saida e a mercado.
// =============================================================
input
  Periodo(2);
  FolgaPct(1);   // folga do preco limite das ordens stop, em %
var
  vEntrada, vSaida, vSaidaAnterior : Float;
begin
  vEntrada       := Highest(High, Periodo);
  vSaida         := Lowest(Low, Periodo);
  vSaidaAnterior := Lowest(Low, Periodo)[1];

  if (IsBought) then
    begin
      if (Close < vSaidaAnterior) then
        SellToCoverAtMarket
      else
        SellToCoverStop(vSaida, vSaida * (1 - FolgaPct * 0.01));
    end
  else
    begin
      BuyStop(vEntrada, vEntrada * (1 + FolgaPct * 0.01));
    end;
end;
