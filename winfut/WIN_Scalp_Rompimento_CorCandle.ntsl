// =============================================================
// WINFUT 1-2 min - Scalp no rompimento pela cor do candle (sem media)
//
// A cada candle fechado:
//   Candle de alta (fechamento acima da abertura) -> compra stop na
//     maxima desse candle.
//   Candle de baixa (fechamento abaixo da abertura) -> venda stop na
//     minima desse candle.
//   Candle sem corpo (fechamento igual a abertura) -> nenhuma ordem.
//   A ordem vale so no candle seguinte; a decisao e refeita a cada
//   candle.
// Saida em OCO de Alvo e Stop pontos a partir do preco medio real da
//   posicao (BuyPrice / SellPrice). Na automacao, uma estrategia OCO
//   escolhida na aba Saida substitui estas saidas.
// Janela de HoraInicio a HoraFim, com zeragem em HoraFim, e filtro de
//   dias da semana.
// Deslocamento: 0 no intradiario | 1 no diario.
// =============================================================
input
  Deslocamento(0);      // 0 = intradiario | 1 = diario
  Alvo(45);
  Stop(250);
  HoraInicio(900);      // primeira entrada a partir deste candle
  HoraFim(1105);        // sem novas entradas e zeragem a partir deste candle
  FolgaPontos(0);       // folga do preco limite das ordens stop
  OperarCompra(true);
  OperarVenda(true);
  Segunda(true);
  Terca(true);
  Quarta(true);
  Quinta(true);
  Sexta(true);
var
  vEntrada, vStop, vAlvo, vGatilho    : Float;
  nBarraPos, nDia                     : Integer;
  bHorarioOk, bDiaOk, bCompra, bVenda : Boolean;
begin
  bCompra := False;
  if (Close[Deslocamento] > Open[Deslocamento]) then
    bCompra := True;
  bVenda := False;
  if (Close[Deslocamento] < Open[Deslocamento]) then
    bVenda := True;

  nDia := DayOfWeek(Date);
  bDiaOk := False;
  if (nDia = 1) and (Segunda) then bDiaOk := True;
  if (nDia = 2) and (Terca)   then bDiaOk := True;
  if (nDia = 3) and (Quarta)  then bDiaOk := True;
  if (nDia = 4) and (Quinta)  then bDiaOk := True;
  if (nDia = 5) and (Sexta)   then bDiaOk := True;

  bHorarioOk := False;
  if (bDiaOk) and (Time >= HoraInicio) and (Time < HoraFim) and (Date[Deslocamento] = Date) then
    bHorarioOk := True;

  if (IsBought) then
    begin
      nBarraPos := CurrentBar;
      vEntrada  := BuyPrice;
      vStop := vEntrada - Stop;
      vAlvo := vEntrada + Alvo;
      if (Time >= HoraFim) or (Close <= vStop) then
        SellToCoverAtMarket
      else
        begin
          SellToCoverLimit(vAlvo);
          SellToCoverStop(vStop, vStop - FolgaPontos);
        end;
    end
  else if (IsSold) then
    begin
      nBarraPos := CurrentBar;
      vEntrada  := SellPrice;
      vStop := vEntrada + Stop;
      vAlvo := vEntrada - Alvo;
      if (Time >= HoraFim) or (Close >= vStop) then
        BuyToCoverAtMarket
      else
        begin
          BuyToCoverLimit(vAlvo);
          BuyToCoverStop(vStop, vStop + FolgaPontos);
        end;
    end;

  if (not IsBought) and (not IsSold) and (bHorarioOk) and (CurrentBar <> nBarraPos) then
    begin
      if (bCompra) and (OperarCompra) then
        begin
          vGatilho := High[Deslocamento];
          BuyStop(vGatilho, vGatilho + FolgaPontos);
        end
      else if (bVenda) and (OperarVenda) then
        begin
          vGatilho := Low[Deslocamento];
          SellShortStop(vGatilho, vGatilho - FolgaPontos);
        end;
    end;
end;
