// =============================================================
// WINFUT 1-2 min - Scalp no rompimento da maxima com filtro de 2 medias
//
// Filtro de compra: fechamento acima da media curta e da longa, e a
//   curta acima da longa (exponenciais de 8 e 80 por padrao).
// Compra: quando um candle fecha com o filtro de compra, o setup arma
//   e deixa uma compra stop na maxima do ultimo candle. Enquanto nao
//   romper, a cada candle novo a ordem desce para a maxima do candle
//   anterior. Com ManterOrdem = true ela continua descendo mesmo que
//   o fechamento perca a media curta, enquanto a curta seguir acima da
//   longa; com false ela e cancelada quando o filtro de compra falha.
// Venda (opcional, desligada por padrao): o espelho.
// Saida sempre em OCO: alvo de Alvo e stop de Stop pontos a partir
//   do preco do rompimento, ativos desde o candle da entrada.
// Horario: entradas so entre HoraInicio e HoraFim; a partir de
//   HoraFim, posicao aberta e zerada a mercado e o setup desarma.
//   O candle de referencia precisa ser do mesmo dia.
// Nao reentra no mesmo candle em que uma operacao terminou; depois
//   de cada operacao, o setup so arma de novo pelo filtro.
//
// Deslocamento: 1 quando o Profit roda o codigo durante o candle
// (o que o seu backtest faz); 0 se ele rodar so no fechamento.
// Horarios no formato HHMM do candle (9:00 = 900).
// =============================================================
input
  Deslocamento(1);      // 1 = roda durante o candle | 0 = so no fechamento
  Alvo(50);
  Stop(250);
  PeriodoCurta(8);
  PeriodoLonga(80);
  TipoMedia(1);         // 1 = exponencial | 0 = aritmetica (vale para as 2)
  HoraInicio(900);      // primeira entrada a partir deste candle
  HoraFim(1100);        // sem novas entradas e zeragem a partir deste candle
  ManterOrdem(true);    // true = ordem segue descendo ate romper | false = cancela quando o filtro falha
  FolgaPontos(20);      // folga do preco limite das ordens stop
  OperarCompra(true);
  OperarVenda(false);
var
  vCurta, vLonga, vFech, vEntrada, vStop, vAlvo : Float;
  nBarraPos                                     : Integer;
  bHorarioOk, bFiltroCompra, bFiltroVenda       : Boolean;
  bArmadoCompra, bArmadoVenda                   : Boolean;
begin
  if (TipoMedia = 1) then
    begin
      vCurta := MediaExp(PeriodoCurta, Close)[Deslocamento];
      vLonga := MediaExp(PeriodoLonga, Close)[Deslocamento];
    end
  else
    begin
      vCurta := Media(PeriodoCurta, Close)[Deslocamento];
      vLonga := Media(PeriodoLonga, Close)[Deslocamento];
    end;
  vFech := Close[Deslocamento];

  bFiltroCompra := False;
  if (vFech > vCurta) and (vFech > vLonga) and (vCurta > vLonga) then
    bFiltroCompra := True;
  bFiltroVenda := False;
  if (vFech < vCurta) and (vFech < vLonga) and (vCurta < vLonga) then
    bFiltroVenda := True;

  bHorarioOk := False;
  if (Time >= HoraInicio) and (Time < HoraFim) and (Date[Deslocamento] = Date) then
    bHorarioOk := True;

  if (not bHorarioOk) then
    begin
      bArmadoCompra := False;
      bArmadoVenda  := False;
    end;

  if (IsBought) then
    begin
      nBarraPos     := CurrentBar;
      bArmadoCompra := False;
      vStop := vEntrada - Stop;
      vAlvo := vEntrada + Alvo;
      if (Time >= HoraFim) or (Close <= vStop) then
        SellToCoverAtMarket
      else
        begin
          SellToCoverLimit(vAlvo);
          SellToCoverStop(vStop, vStop - FolgaPontos);
        end;
    end
  else if (IsSold) then
    begin
      nBarraPos    := CurrentBar;
      bArmadoVenda := False;
      vStop := vEntrada + Stop;
      vAlvo := vEntrada - Alvo;
      if (Time >= HoraFim) or (Close >= vStop) then
        BuyToCoverAtMarket
      else
        begin
          BuyToCoverLimit(vAlvo);
          BuyToCoverStop(vStop, vStop + FolgaPontos);
        end;
    end
  else if (bHorarioOk) and (CurrentBar <> nBarraPos) then
    begin
      if (bFiltroCompra) and (OperarCompra) then
        begin
          bArmadoCompra := True;
          bArmadoVenda  := False;
        end
      else if (bFiltroVenda) and (OperarVenda) then
        begin
          bArmadoVenda  := True;
          bArmadoCompra := False;
        end;

      // desarma quando a tendencia das medias vira ou, sem ManterOrdem,
      // quando o filtro do lado armado falha
      if (vCurta <= vLonga) then
        bArmadoCompra := False;
      if (vCurta >= vLonga) then
        bArmadoVenda := False;
      if (not ManterOrdem) and (not bFiltroCompra) then
        bArmadoCompra := False;
      if (not ManterOrdem) and (not bFiltroVenda) then
        bArmadoVenda := False;

      if (bArmadoCompra) then
        begin
          vEntrada := High[Deslocamento];
          BuyStop(vEntrada, vEntrada + FolgaPontos);
        end
      else if (bArmadoVenda) then
        begin
          vEntrada := Low[Deslocamento];
          SellShortStop(vEntrada, vEntrada - FolgaPontos);
        end;
    end;
end;
