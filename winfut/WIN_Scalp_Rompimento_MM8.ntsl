// =============================================================
// WINFUT 1-2 min - Scalp no rompimento da maxima com filtro de medias
//
// Filtro de compra: fechamento acima da media curta e da longa, a
//   curta acima da longa e, com UsarTerceira = true, fechamento acima
//   da terceira media. Venda: o espelho.
//   Padrao: medias aritmeticas de 9 e 20, alvo 45, stop 250.
// Compra stop na maxima do ultimo candle; enquanto nao romper, a
//   ordem desce candle a candle (ManterOrdem). Saida em OCO de Alvo e
//   Stop pontos a partir do preco medio real da posicao (BuyPrice /
//   SellPrice). Janela de HoraInicio a HoraFim, com zeragem em
//   HoraFim, e filtro de dias da semana.
// Na automacao, uma estrategia OCO escolhida na aba Saida substitui
//   as saidas deste codigo.
// =============================================================
input
  Deslocamento(0);      // 0 = intradiario | 1 = diario
  Alvo(45);
  Stop(250);
  PeriodoCurta(9);
  PeriodoLonga(20);
  UsarTerceira(false);  // true = liga o filtro da terceira media
  PeriodoTerceira(200); // periodo da terceira media
  TipoMedia(0);         // 1 = exponencial | 0 = aritmetica (vale para as 3)
  HoraInicio(900);      // primeira entrada a partir deste candle
  HoraFim(1105);        // sem novas entradas e zeragem a partir deste candle
  ManterOrdem(true);    // true = ordem segue descendo ate romper | false = cancela quando o filtro falha
  FolgaPontos(0);       // folga do preco limite das ordens stop
  OperarCompra(true);
  OperarVenda(true);
  Segunda(true);
  Terca(true);
  Quarta(true);
  Quinta(true);
  Sexta(true);
var
  vCurta, vLonga, vTerceira, vFech, vEntrada, vStop, vAlvo : Float;
  vGatilho                                                 : Float;
  nBarraPos, nDia                                          : Integer;
  bHorarioOk, bFiltroCompra, bFiltroVenda                  : Boolean;
  bDiaOk                                                   : Boolean;
  bArmadoCompra, bArmadoVenda                              : Boolean;
begin
  if (TipoMedia = 1) then
    begin
      vCurta    := MediaExp(PeriodoCurta, Close)[Deslocamento];
      vLonga    := MediaExp(PeriodoLonga, Close)[Deslocamento];
      vTerceira := MediaExp(PeriodoTerceira, Close)[Deslocamento];
    end
  else
    begin
      vCurta    := Media(PeriodoCurta, Close)[Deslocamento];
      vLonga    := Media(PeriodoLonga, Close)[Deslocamento];
      vTerceira := Media(PeriodoTerceira, Close)[Deslocamento];
    end;
  vFech := Close[Deslocamento];

  bFiltroCompra := False;
  if (vFech > vCurta) and (vFech > vLonga) and (vCurta > vLonga) then
    bFiltroCompra := True;
  bFiltroVenda := False;
  if (vFech < vCurta) and (vFech < vLonga) and (vCurta < vLonga) then
    bFiltroVenda := True;

  // terceira media: compra so acima dela, venda so abaixo
  if (UsarTerceira) and (vFech <= vTerceira) then
    bFiltroCompra := False;
  if (UsarTerceira) and (vFech >= vTerceira) then
    bFiltroVenda := False;

  nDia := DayOfWeek(Date);
  bDiaOk := False;
  if (nDia = 1) and (Segunda) then bDiaOk := True;
  if (nDia = 2) and (Terca)   then bDiaOk := True;
  if (nDia = 3) and (Quarta)  then bDiaOk := True;
  if (nDia = 4) and (Quinta)  then bDiaOk := True;
  if (nDia = 5) and (Sexta)   then bDiaOk := True;

  bHorarioOk := False;
  if (bDiaOk) and (Time >= HoraInicio) and (Time < HoraFim) and (Date[Deslocamento] = Date) then
    bHorarioOk := True;

  if (not bHorarioOk) then
    begin
      bArmadoCompra := False;
      bArmadoVenda  := False;
    end;

  if (IsBought) then
    begin
      nBarraPos     := CurrentBar;
      bArmadoCompra := False;
      vEntrada := BuyPrice;
      vStop := vEntrada - Stop;
      vAlvo := vEntrada + Alvo;
      if (Time >= HoraFim) or (Close <= vStop) then
        SellToCoverAtMarket
      else
        begin
          SellToCoverLimit(vAlvo);
          SellToCoverStop(vStop, vStop - FolgaPontos);
        end;
    end
  else if (IsSold) then
    begin
      nBarraPos    := CurrentBar;
      bArmadoVenda := False;
      vEntrada := SellPrice;
      vStop := vEntrada + Stop;
      vAlvo := vEntrada - Alvo;
      if (Time >= HoraFim) or (Close >= vStop) then
        BuyToCoverAtMarket
      else
        begin
          BuyToCoverLimit(vAlvo);
          BuyToCoverStop(vStop, vStop + FolgaPontos);
        end;
    end;

  if (not IsBought) and (not IsSold) and (bHorarioOk) and (CurrentBar <> nBarraPos) then
    begin
      if (bFiltroCompra) and (OperarCompra) then
        begin
          bArmadoCompra := True;
          bArmadoVenda  := False;
        end
      else if (bFiltroVenda) and (OperarVenda) then
        begin
          bArmadoVenda  := True;
          bArmadoCompra := False;
        end;

      // desarma quando a tendencia das medias vira ou, sem ManterOrdem,
      // quando o filtro do lado armado falha
      if (vCurta <= vLonga) then
        bArmadoCompra := False;
      if (vCurta >= vLonga) then
        bArmadoVenda := False;
      if (not ManterOrdem) and (not bFiltroCompra) then
        bArmadoCompra := False;
      if (not ManterOrdem) and (not bFiltroVenda) then
        bArmadoVenda := False;

      if (bArmadoCompra) then
        begin
          vGatilho := High[Deslocamento];
          BuyStop(vGatilho, vGatilho + FolgaPontos);
        end
      else if (bArmadoVenda) then
        begin
          vGatilho := Low[Deslocamento];
          SellShortStop(vGatilho, vGatilho - FolgaPontos);
        end;
    end;
end;
