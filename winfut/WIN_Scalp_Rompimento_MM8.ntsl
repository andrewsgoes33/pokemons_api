// =============================================================
// WINFUT 1-2 min - Scalp no rompimento da maxima com media de 8
//
// Compra: quando um candle fecha acima da media exponencial de
//   PeriodoMedia, o setup arma e deixa uma compra stop na maxima do
//   ultimo candle. Enquanto nao romper, a cada candle novo a ordem
//   desce para a maxima do candle anterior. Com ManterOrdem = true a
//   ordem continua descendo mesmo que os candles fechem abaixo da
//   media; com false ela e cancelada quando o fechamento perde a media.
// Venda (opcional, desligada por padrao): o espelho, com a venda stop
//   subindo para a minima do candle anterior.
// Com compra e venda ligadas, o lado acompanha a media: fechou acima
//   arma a compra, fechou abaixo arma a venda.
// Saida sempre em OCO: alvo de Alvo e stop de Stop pontos a partir
//   do preco do rompimento, ativos desde o candle da entrada.
// Horario: entradas so entre HoraInicio e HoraFim; a partir de
//   HoraFim, posicao aberta e zerada a mercado e o setup desarma.
//   O candle de referencia precisa ser do mesmo dia.
// Nao reentra no mesmo candle em que uma operacao terminou; depois
//   de cada operacao, o setup so arma de novo pela media.
//
// Deslocamento: 1 quando o Profit roda o codigo durante o candle
// (o que o seu backtest faz); 0 se ele rodar so no fechamento.
// Horarios no formato HHMM do candle (9:00 = 900).
// =============================================================
input
  Deslocamento(1);      // 1 = roda durante o candle | 0 = so no fechamento
  Alvo(50);
  Stop(250);
  PeriodoMedia(8);
  TipoMedia(1);         // 1 = exponencial | 0 = aritmetica
  HoraInicio(900);      // primeira entrada a partir deste candle
  HoraFim(1100);        // sem novas entradas e zeragem a partir deste candle
  ManterOrdem(true);    // true = ordem segue descendo ate romper | false = cancela ao perder a media
  FolgaPontos(20);      // folga do preco limite das ordens stop
  OperarCompra(true);
  OperarVenda(false);
var
  vMedia, vEntrada, vStop, vAlvo : Float;
  nBarraPos                      : Integer;
  bHorarioOk                     : Boolean;
  bArmadoCompra, bArmadoVenda    : Boolean;
begin
  if (TipoMedia = 1) then
    vMedia := MediaExp(PeriodoMedia, Close)[Deslocamento]
  else
    vMedia := Media(PeriodoMedia, Close)[Deslocamento];

  bHorarioOk := False;
  if (Time >= HoraInicio) and (Time < HoraFim) and (Date[Deslocamento] = Date) then
    bHorarioOk := True;

  if (not bHorarioOk) then
    begin
      bArmadoCompra := False;
      bArmadoVenda  := False;
    end;

  if (IsBought) then
    begin
      nBarraPos     := CurrentBar;
      bArmadoCompra := False;
      vStop := vEntrada - Stop;
      vAlvo := vEntrada + Alvo;
      if (Time >= HoraFim) or (Close <= vStop) then
        SellToCoverAtMarket
      else
        begin
          SellToCoverLimit(vAlvo);
          SellToCoverStop(vStop, vStop - FolgaPontos);
        end;
    end
  else if (IsSold) then
    begin
      nBarraPos    := CurrentBar;
      bArmadoVenda := False;
      vStop := vEntrada + Stop;
      vAlvo := vEntrada - Alvo;
      if (Time >= HoraFim) or (Close >= vStop) then
        BuyToCoverAtMarket
      else
        begin
          BuyToCoverLimit(vAlvo);
          BuyToCoverStop(vStop, vStop + FolgaPontos);
        end;
    end
  else if (bHorarioOk) and (CurrentBar <> nBarraPos) then
    begin
      if (Close[Deslocamento] > vMedia) then
        begin
          if (OperarCompra) then
            bArmadoCompra := True;
          if (OperarCompra) or (not ManterOrdem) then
            bArmadoVenda := False;
        end
      else if (Close[Deslocamento] < vMedia) then
        begin
          if (OperarVenda) then
            bArmadoVenda := True;
          if (OperarVenda) or (not ManterOrdem) then
            bArmadoCompra := False;
        end;

      if (bArmadoCompra) then
        begin
          vEntrada := High[Deslocamento];
          BuyStop(vEntrada, vEntrada + FolgaPontos);
        end
      else if (bArmadoVenda) then
        begin
          vEntrada := Low[Deslocamento];
          SellShortStop(vEntrada, vEntrada - FolgaPontos);
        end;
    end;
end;
