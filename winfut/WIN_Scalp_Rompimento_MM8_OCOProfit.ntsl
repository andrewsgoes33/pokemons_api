// =============================================================
// WINFUT 1-2 min - Scalp no rompimento da maxima com filtro de 2 medias
// VERSAO SO DE ENTRADA: a OCO (alvo e stop) fica na configuracao do
// Profit ("Abertura de Posicao" no backtest e na automacao), que monta
// as duas ordens a partir do preco real de execucao.
//
// Filtro de compra: fechamento acima da media curta e da longa, e a
//   curta acima da longa (exponenciais de 8 e 80 por padrao).
// Compra: quando um candle fecha com o filtro de compra, o setup arma
//   e deixa uma compra stop na maxima do ultimo candle (um tick acima
//   se o candle fechou na propria maxima). Enquanto nao romper, a cada
//   candle novo a ordem desce para a maxima do candle anterior. Com
//   ManterOrdem = true ela continua descendo mesmo que o fechamento
//   perca a media curta, enquanto a curta seguir acima da longa; com
//   false ela e cancelada quando o filtro de compra falha.
// Venda (opcional, desligada por padrao): o espelho.
// Saida: OCO configurada no Profit (ex.: alvo 50, stop 250). O codigo
//   so zera a mercado a partir de HoraFim.
// Horario: entradas so entre HoraInicio e HoraFim; a partir de
//   HoraFim, posicao aberta e zerada a mercado e o setup desarma.
// Dias da semana: so arma e entra nos dias marcados como true.
//
// O Profit nao leva o valor das variaveis de um candle para o outro:
// cada candle comeca com elas zeradas. Por isso o setup armado e
// copiado do candle anterior com [1] no inicio de cada execucao.
//
// Deslocamento: 0 no intradiario (o Profit roda o codigo no fechamento
// de cada candle, e [0] e o candle que acabou de fechar); 1 no diario.
// Horarios no formato HHMM do candle (9:00 = 900).
// =============================================================
input
  Deslocamento(0);      // 0 = intradiario | 1 = diario
  PeriodoCurta(8);
  PeriodoLonga(80);
  TipoMedia(1);         // 1 = exponencial | 0 = aritmetica (vale para as 2)
  HoraInicio(900);      // primeira entrada a partir deste candle
  HoraFim(1100);        // sem novas entradas e zeragem a partir deste candle
  ManterOrdem(true);    // true = ordem segue descendo ate romper | false = cancela quando o filtro falha
  TickMinimo(5);        // tamanho do tick do ativo (WIN = 5 pontos)
  FolgaPontos(20);      // folga do preco limite das ordens stop
  OperarCompra(true);
  OperarVenda(false);
  Segunda(true);
  Terca(true);
  Quarta(true);
  Quinta(true);
  Sexta(true);
var
  vCurta, vLonga, vFech, vGatilho : Float;
  nDia, nArmado                   : Integer;
  bHorarioOk, bFiltroCompra, bFiltroVenda, bDiaOk : Boolean;
begin
  // estado vindo do candle anterior
  nArmado := nArmado[1];   // 1 = compra armada | -1 = venda armada | 0 = nada

  if (TipoMedia = 1) then
    begin
      vCurta := MediaExp(PeriodoCurta, Close)[Deslocamento];
      vLonga := MediaExp(PeriodoLonga, Close)[Deslocamento];
    end
  else
    begin
      vCurta := Media(PeriodoCurta, Close)[Deslocamento];
      vLonga := Media(PeriodoLonga, Close)[Deslocamento];
    end;
  vFech := Close[Deslocamento];

  bFiltroCompra := False;
  if (vFech > vCurta) and (vFech > vLonga) and (vCurta > vLonga) then
    bFiltroCompra := True;
  bFiltroVenda := False;
  if (vFech < vCurta) and (vFech < vLonga) and (vCurta < vLonga) then
    bFiltroVenda := True;

  nDia := DayOfWeek(Date);
  bDiaOk := False;
  if (nDia = 1) and (Segunda) then bDiaOk := True;
  if (nDia = 2) and (Terca)   then bDiaOk := True;
  if (nDia = 3) and (Quarta)  then bDiaOk := True;
  if (nDia = 4) and (Quinta)  then bDiaOk := True;
  if (nDia = 5) and (Sexta)   then bDiaOk := True;

  bHorarioOk := False;
  if (bDiaOk) and (Time >= HoraInicio) and (Time < HoraFim) and (Date[Deslocamento] = Date) then
    bHorarioOk := True;

  if (not bHorarioOk) then
    nArmado := 0;

  if (IsBought) then
    begin
      nArmado := 0;
      if (Time >= HoraFim) then
        SellToCoverAtMarket;
    end
  else if (IsSold) then
    begin
      nArmado := 0;
      if (Time >= HoraFim) then
        BuyToCoverAtMarket;
    end
  else
    begin
      if (bHorarioOk) then
        begin
          if (bFiltroCompra) and (OperarCompra) then
            nArmado := 1
          else if (bFiltroVenda) and (OperarVenda) then
            nArmado := -1;

          // desarma quando a tendencia das medias vira ou, sem ManterOrdem,
          // quando o filtro do lado armado falha
          if (nArmado = 1) and ((vCurta <= vLonga) or ((not ManterOrdem) and (not bFiltroCompra))) then
            nArmado := 0;
          if (nArmado = -1) and ((vCurta >= vLonga) or ((not ManterOrdem) and (not bFiltroVenda))) then
            nArmado := 0;

          if (nArmado = 1) then
            begin
              vGatilho := High[Deslocamento];
              if (Close[Deslocamento] >= High[Deslocamento]) then
                vGatilho := vGatilho + TickMinimo;
              BuyStop(vGatilho, vGatilho + FolgaPontos);
            end
          else if (nArmado = -1) then
            begin
              vGatilho := Low[Deslocamento];
              if (Close[Deslocamento] <= Low[Deslocamento]) then
                vGatilho := vGatilho - TickMinimo;
              SellShortStop(vGatilho, vGatilho - FolgaPontos);
            end;
        end;
    end;
end;
