// =============================================================
// L&S Volatility Index + IFR - somente compra
//
// Entrada (no fechamento do candle, compra a mercado):
//   candle positivo (fechamento acima da abertura)
//   L&S Volatility Index acima de NivelLS (preco esticado da media)
//   IFR abaixo de NivelIFRCompra (sobrevendido)
// Saida: IFR chega em NivelIFRSaida, a mercado.
// Sem stop e sem alvo. Uma operacao por vez.
// Day trade: horario de inicio, ultima entrada e zeragem ficam na
// configuracao do Profit.
// LSVolatilityIndex e a funcao do proprio Profit (mesmo valor do
// indicador L&S Volatility Index).
//
// Deslocamento: 0 no intradiario, 1 no diario.
// No intradiario o Profit roda o codigo no fechamento do candle, e a
// compra a mercado sai na abertura do candle seguinte. No diario o
// codigo roda durante o candle, e o [1] faz a conta usar o candle de
// ontem; a compra sai na abertura do dia.
// =============================================================
input
  Deslocamento(0);     // 0 = intradiario | 1 = diario
  NivelLS(25);         // compra so com o L&S acima deste nivel
  PeriodoIFR(9);       // periodo do IFR
  NivelIFRCompra(30);  // compra com o IFR abaixo deste nivel
  NivelIFRSaida(70);   // sai quando o IFR chega neste nivel
var
  vLSVI, vIFR : Float;
begin
  vLSVI := LSVolatilityIndex[Deslocamento];
  vIFR  := RSI(PeriodoIFR, 0)[Deslocamento];

  if (IsBought) then
    begin
      if (vIFR >= NivelIFRSaida) then
        SellToCoverAtMarket;
    end
  else
    begin
      if (Close[Deslocamento] > Open[Deslocamento]) and (vLSVI > NivelLS) and (vIFR < NivelIFRCompra) then
        BuyAtMarket;
    end;
end;
